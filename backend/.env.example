# Copy to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Port the Express server listens on
PORT=5000

# MongoDB connection string.
# The server reads MONGO_URI (not MONGODB_URI) and exits immediately if
# this is missing or unreachable.
# Atlas example:
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sentinel_siem?retryWrites=true&w=majority
# Local example:
# MONGO_URI=mongodb://127.0.0.1:27017/sentinel_siem
